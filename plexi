class MpvIPC:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(1)
        self.sock.connect(path)
        self.buf = b""
        self.rid = 0

    def get(self, prop):
        self.rid += 1
        msg = {"command": ["get_property", prop], "request_id": self.rid}
        self.sock.sendall(json.dumps(msg).encode() + b"\n")
        while True:
            while b"\n" not in self.buf:
                chunk = self.sock.recv(4096)
                if not chunk:
                    raise OSError("mpv closed the socket")
                self.buf += chunk
            line, self.buf = self.buf.split(b"\n", 1)
            reply = json.loads(line)
            if reply.get("request_id") == self.rid:
                return reply.get("data") if reply.get("error") == "success" else None

    def close(self):
        self.sock.close()


class Player(threading.Thread):
    """Runs mpv for one item and reports progress back to Plex."""

    def __init__(self, app, node, offset_ms):
        super().__init__(daemon=True)
        self.app, self.node, self.offset = app, node, offset_ms
        self.title = node.media_title()
        self.proc = None

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def run(self):
        plex, item = self.app.plex, self.node.data
        sock = os.path.join(tempfile.gettempdir(), f"plexi-{os.getpid()}-{item['ratingKey']}.sock")
        try:
            url = plex.stream_url(item)
        except (KeyError, IndexError):
            self.app.events.put(("error", "nothing playable for this item"))
            return
        cmd = [
            "mpv",
            "--force-window=immediate",
            f"--force-media-title={self.title}",
            f"--input-ipc-server={sock}",
            f"--start={self.offset / 1000:.3f}",
            "--",
            url,
        ]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except FileNotFoundError:
            self.app.events.put(("error", "mpv not found — install it with `omarchy pkg add mpv`"))
            return

        pos, paused, ipc, last_report = self.offset / 1000, False, None, 0.0
        while self.proc.poll() is None:
            time.sleep(1)
            try:
                ipc = ipc or MpvIPC(sock)
                p = ipc.get("time-pos")
                if isinstance(p, (int, float)):
                    pos = p
                paused = bool(ipc.get("pause"))
            except (OSError, ValueError):
                ipc = None
            if time.monotonic() - last_report >= 10:
                last_report = time.monotonic()
                try:
                    plex.timeline(item, "paused" if paused else "playing", pos * 1000)
                except PlexError:
                    pass

        if ipc:
            ipc.close()
        try:
            os.unlink(sock)
        except OSError:
            pass
        duration = item.get("duration") or 0
        try:
            plex.timeline(item, "stopped", pos * 1000)
            if duration and pos * 1000 >= duration * 0.9:
                plex.scrobble(item["ratingKey"])
        except PlexError:
            pass
        self.app.events.put(("played", self.node))


# ── input ────────────────────────────────────────────────────────────────

ESCAPES = {
    b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
    b"OA": "up", b"OB": "down", b"OC": "right", b"OD": "left",
    b"[H": "home", b"[F": "end", b"OH": "home", b"OF": "end",
    b"[1~": "home", b"[4~": "end", b"[5~": "pgup", b"[6~": "pgdn",
}
CONTROLS = {3: "ctrl-c", 4: "ctrl-d", 21: "ctrl-u", 9: "tab"}


def read_key(fd):
    b = os.read(fd, 1)
    if not b:
        return None
    c = b[0]
    if c == 0x1B:
        if not select.select([fd], [], [], 0.03)[0]:
            return "esc"
        return ESCAPES.get(os.read(fd, 8))
    if c in (10, 13):
        return "enter"
    if c in (8, 127):
        return "backspace"
    if c < 32:
        return CONTROLS.get(c)
    extra = 0 if c < 0x80 else 1 if c >> 5 == 0b110 else 2 if c >> 4 == 0b1110 else 3
    if extra:
        b += os.read(fd, extra)
    return b.decode("utf-8", "replace")


