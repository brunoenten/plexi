class Node:
    __slots__ = ("data", "kind", "parent", "depth", "children", "expanded", "detailed")

    def __init__(self, data, kind, parent):
        self.data = data
        self.kind = kind
        self.parent = parent
        self.depth = parent.depth + 1 if parent else -1
        self.children = None
        self.expanded = False
        self.detailed = False

    @property
    def key(self):
        return self.data.get("ratingKey") or self.data.get("key")

    @property
    def leaf(self):
        return self.kind in LEAVES

    def in_progress(self):
        return self.leaf and bool(self.data.get("viewOffset"))

    def watched(self):
        d = self.data
        if self.leaf:
            return d.get("viewCount", 0) > 0 and not d.get("viewOffset")
        leaves = d.get("leafCount", 0)
        return leaves > 0 and d.get("viewedLeafCount", 0) >= leaves

    def label(self):
        d = self.data
        in_hub = self.parent is not None and self.parent.kind == "hub"
        if in_hub and self.kind == "episode":
            return f"{d.get('grandparentTitle', '')} · S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} · {d.get('title', '')}"
        if in_hub and self.kind == "season":
            return f"{d.get('parentTitle', '')} · {d.get('title', '')}"
        if self.kind == "episode" and "index" in d:
            return f"{d['index']:>2}  {d.get('title', '')}"
        return d.get("title", "")

    def meta(self):
        d = self.data
        if self.kind in ("section", "hub"):
            return str(len(self.children)) if self.children is not None else ""
        if self.kind == "show":
            parts = [str(d["year"])] if d.get("year") else []
            if d.get("childCount"):
                parts.append(plural(d["childCount"], "season"))
            return " · ".join(parts)
        if self.kind == "season":
            return f"{d.get('viewedLeafCount', 0)}/{d.get('leafCount', 0)}"
        if self.kind == "episode":
            if self.in_progress():
                return f"{fmt_duration(d.get('duration', 0) - d['viewOffset'])} left"
            return fmt_duration(d.get("duration")) if d.get("duration") else ""
        if self.kind == "movie":
            parts = [str(d["year"])] if d.get("year") else []
            if d.get("duration"):
                parts.append(fmt_duration(d["duration"]))
            return " · ".join(parts)
        return ""

    def media_title(self):
        d = self.data
        if self.kind == "episode":
            return f"{d.get('grandparentTitle', '')} — S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} — {d.get('title', '')}"
        if d.get("year"):
            return f"{d.get('title', '')} ({d['year']})"
        return d.get("title", "")


