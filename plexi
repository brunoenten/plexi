def _rgb(value):
    h = value.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


class Theme:
    def __init__(self):
        self.colors = dict(FALLBACK)
        self.stamp = None
        self.reload()

    def reload(self):
        path = next((p for p in THEME_PATHS if os.path.exists(p)), None)
        if not path:
            return
        try:
            stamp = (path, os.stat(path).st_mtime)
            if stamp == self.stamp:
                return
            with open(path, "rb") as f:
                data = tomllib.load(f)
        except (OSError, tomllib.TOMLDecodeError):
            return
        self.stamp = stamp
        colors = {k: v for k, v in data.items() if isinstance(v, str) and len(v) == 7 and v[0] == "#"}
        self.colors = {**FALLBACK, **colors}

    def fg(self, name):
        return "\x1b[38;2;%d;%d;%dm" % _rgb(self.colors[name])

    def bg(self, name):
        return "\x1b[48;2;%d;%d;%dm" % _rgb(self.colors[name])


# ── text helpers ─────────────────────────────────────────────────────────


def cwidth(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def wlen(s):
    return sum(cwidth(c) for c in s)


def trunc(s, width):
    if width <= 0:
        return ""
    if wlen(s) <= width:
        return s
    out, used = [], 0
    for ch in s:
        w = cwidth(ch)
        if used + w > width - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "…"


class Line:
    """A fixed-width row of styled segments."""

    def __init__(self, width, base=""):
        self.width, self.base, self.parts, self.used = width, base, [], 0

    def add(self, text, style=""):
        text = trunc(text, self.width - self.used)
        if text:
            self.parts.append(self.base + style + text + RESET)
            self.used += wlen(text)
        return self

    def right(self, text, style=""):
        gap = self.width - self.used - wlen(text)
        if gap > 0:
            self.add(" " * gap)
        return self.add(text, style)

    def raw(self, rendered, width):
        self.parts.append(rendered)
        self.used += width
        return self

    def __str__(self):
        if self.used < self.width:
            self.add(" " * (self.width - self.used))
        return "".join(self.parts)


def fmt_duration(ms):
    m = int(ms or 0) // 60000
    return f"{m // 60}h {m % 60:02d}m" if m >= 60 else f"{m}m"


def fmt_clock(ms):
    s = int(ms or 0) // 1000
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def plural(n, word):
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


# ── plex ─────────────────────────────────────────────────────────────────


class PlexError(Exception):
    pass


def client_headers(client_id, token=None):
    headers = {
        "Accept": "application/json",
        "X-Plex-Product": PRODUCT,
        "X-Plex-Version": VERSION,
        "X-Plex-Client-Identifier": client_id,
        "X-Plex-Platform": "Linux",
        "X-Plex-Device": "Linux",
        "X-Plex-Device-Name": socket.gethostname(),
    }
    if token:
        headers["X-Plex-Token"] = token
    return headers


def http(url, headers, method="GET", timeout=10, parse=True):
    req = urllib.request.Request(url, method=method, headers=headers, data=b"" if method == "POST" else None)
    host = urllib.parse.urlsplit(url).netloc
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
    except urllib.error.HTTPError as e:
        hint = " (token rejected — run `plexi login`)" if e.code == 401 else ""
        raise PlexError(f"HTTP {e.code} from {host}{hint}") from e
    except (urllib.error.URLError, OSError) as e:
        raise PlexError(f"can't reach {host}: {getattr(e, 'reason', e)}") from e
    if not parse or not body.strip():
        return {}
    try:
        return json.loads(body)
    except ValueError as e:
        raise PlexError(f"unexpected response from {host}") from e


class Plex:
    def __init__(self, url, token, client_id):
        self.url = url.rstrip("/")
        self.token = token
        self.headers = client_headers(client_id, token)

    def _url(self, path, params):
        return self.url + path + ("?" + urllib.parse.urlencode(params) if params else "")

    def get(self, path, **params):
        return http(self._url(path, params), self.headers).get("MediaContainer", {})

    def call(self, path, **params):
        http(self._url(path, params), self.headers, parse=False)

    def sections(self):
        dirs = self.get("/library/sections").get("Directory", [])
        return [d for d in dirs if d.get("type") in ("movie", "show")]

    def continue_watching(self):
        try:
            items = self.get("/hubs/continueWatching/items").get("Metadata", [])
        except PlexError:
            items = self.get("/library/onDeck").get("Metadata", [])
        return [i for i in items if i.get("type") in PLAYABLE]

    def recently_added(self, limit=50):
        paging = {"X-Plex-Container-Start": 0, "X-Plex-Container-Size": limit}
        items = self.get("/library/recentlyAdded", **paging).get("Metadata", [])
        return [i for i in items if i.get("type") in BROWSABLE][:limit]

    def items(self, section_key):
        return self.get(f"/library/sections/{section_key}/all").get("Metadata", [])

    def children(self, rating_key):
        return self.get(f"/library/metadata/{rating_key}/children", excludeAllLeaves=1).get("Metadata", [])

    def metadata(self, rating_key):
        found = self.get(f"/library/metadata/{rating_key}").get("Metadata") or [None]
        return found[0]

    def stream_url(self, item):
        part = item["Media"][0]["Part"][0]["key"]
        return self._url(part, {"X-Plex-Token": self.token})

    def scrobble(self, rating_key, watched=True):
        path = "/:/scrobble" if watched else "/:/unscrobble"
        self.call(path, identifier="com.plexapp.plugins.library", key=rating_key)

    def timeline(self, item, state, time_ms):
        rk = item["ratingKey"]
        self.call(
            "/:/timeline",
            ratingKey=rk,
            key=f"/library/metadata/{rk}",
            state=state,
            time=int(time_ms),
            duration=int(item.get("duration") or 0),
        )


# ── config & login ───────────────────────────────────────────────────────


def load_config():
    try:
        with open(CONFIG_PATH, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for key, value in cfg.items():
            f.write(f"{key} = {json.dumps(value)}\n")
    os.replace(tmp, CONFIG_PATH)


def login(theme):
    accent, dim, fg = theme.fg("accent"), theme.fg("light_foreground"), theme.fg("foreground")
    cfg = load_config()
    client_id = cfg.get("client_id") or str(uuid.uuid4())
    headers = client_headers(client_id)

    pin = http("https://plex.tv/api/v2/pins?strong=true", headers, method="POST")
    auth_url = "https://app.plex.tv/auth#?" + urllib.parse.urlencode(
        {"clientID": client_id, "code": pin["code"], "context[device][product]": PRODUCT}
    )
    print(f"\n  {accent}{BOLD}plexi{RESET}{fg} — sign in to Plex in your browser{RESET}")
    print(f"  {dim}{auth_url}{RESET}\n")
    try:
        subprocess.Popen(["xdg-open", auth_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass

    print(f"  {dim}waiting for approval…{RESET}", flush=True)
    token, deadline = None, time.monotonic() + 300
    while not token and time.monotonic() < deadline:
        time.sleep(2)
        token = http(f"https://plex.tv/api/v2/pins/{pin['id']}", headers).get("authToken")
    if not token:
        raise PlexError("sign-in timed out")

    resources = http(
        "https://clients.plex.tv/api/v2/resources?includeHttps=1&includeRelay=1",
        client_headers(client_id, token),
    )
    servers = [r for r in resources if "server" in (r.get("provides") or "")]
    if not servers:
        raise PlexError("no Plex Media Server found on this account")

    server = servers[0]
    if len(servers) > 1:
        print()
        for i, s in enumerate(servers, 1):
            print(f"  {accent}{i}{RESET}  {fg}{s['name']}{RESET}")
        while True:
            choice = input(f"\n  {dim}server [1]:{RESET} ").strip() or "1"
            if choice.isdigit() and 1 <= int(choice) <= len(servers):
                server = servers[int(choice) - 1]
                break

    server_token = server.get("accessToken") or token
    connections = sorted(
        server.get("connections") or [],
        key=lambda c: (bool(c.get("relay")), not c.get("local")),
    )
    print(f"  {dim}connecting to {server['name']}…{RESET}", flush=True)
    for conn in connections:
        try:
            http(conn["uri"].rstrip("/") + "/identity", client_headers(client_id, server_token), timeout=4)
            break
        except PlexError:
            continue
    else:
        raise PlexError(f"couldn't reach {server['name']} on any of its addresses")

    cfg.update(server=conn["uri"], token=server_token, server_name=server["name"], client_id=client_id)
    save_config(cfg)
    print(f"  {theme.fg('green')}✓{RESET} {fg}signed in to {server['name']}{RESET}\n")
    return cfg


# ── tree ─────────────────────────────────────────────────────────────────

LEAVES = ("movie", "episode")
PLAYABLE = LEAVES
BROWSABLE = ("movie", "show", "season", "episode")
SECTION_ICONS = {"movie": "\uf008", "show": "\uf26c", "continue": "\uf144", "recent": "\uf017"}
HUBS = [
    {"key": "hub:continue", "hub": "continue", "title": "Continue Watching", "summary": "in progress and up next"},
    {"key": "hub:recent", "hub": "recent", "title": "Recently Added", "summary": "newest across all libraries"},
]
CONTAINERS = ("root", "hub", "section")


class Node:
    __slots__ = ("data", "kind", "parent", "depth", "children", "expanded")

    def __init__(self, data, kind, parent):
        self.data = data
        self.kind = kind
        self.parent = parent
        self.depth = parent.depth + 1 if parent else -1
        self.children = None
        self.expanded = False

    @property
    def key(self):
        return self.data.get("ratingKey") or self.data.get("key")

    @property
    def leaf(self):
        return self.kind in LEAVES

    def in_progress(self):
        return self.leaf and bool(self.data.get("viewOffset"))

    def watched(self):
        d = self.data
        if self.leaf:
            return d.get("viewCount", 0) > 0 and not d.get("viewOffset")
        leaves = d.get("leafCount", 0)
        return leaves > 0 and d.get("viewedLeafCount", 0) >= leaves

    def label(self):
        d = self.data
        in_hub = self.parent is not None and self.parent.kind == "hub"
        if in_hub and self.kind == "episode":
            return f"{d.get('grandparentTitle', '')} · S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} · {d.get('title', '')}"
        if in_hub and self.kind == "season":
            return f"{d.get('parentTitle', '')} · {d.get('title', '')}"
        if self.kind == "episode" and "index" in d:
            return f"{d['index']:>2}  {d.get('title', '')}"
        return d.get("title", "")

    def meta(self):
        d = self.data
        if self.kind in ("section", "hub"):
            return str(len(self.children)) if self.children is not None else ""
        if self.kind == "show":
            parts = [str(d["year"])] if d.get("year") else []
            if d.get("childCount"):
                parts.append(plural(d["childCount"], "season"))
            return " · ".join(parts)
        if self.kind == "season":
            return f"{d.get('viewedLeafCount', 0)}/{d.get('leafCount', 0)}"
        if self.kind == "episode":
            if self.in_progress():
                return f"{fmt_duration(d.get('duration', 0) - d['viewOffset'])} left"
            return fmt_duration(d.get("duration")) if d.get("duration") else ""
        if self.kind == "movie":
            parts = [str(d["year"])] if d.get("year") else []
            if d.get("duration"):
                parts.append(fmt_duration(d["duration"]))
            return " · ".join(parts)
        return ""

    def media_title(self):
        d = self.data
        if self.kind == "episode":
            return f"{d.get('grandparentTitle', '')} — S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} — {d.get('title', '')}"
        if d.get("year"):
            return f"{d.get('title', '')} ({d['year']})"
        return d.get("title", "")


