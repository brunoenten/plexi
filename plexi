def load_config():
    try:
        with open(CONFIG_PATH, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for key, value in cfg.items():
            f.write(f"{key} = {json.dumps(value)}\n")
    os.replace(tmp, CONFIG_PATH)


RESOURCES_URL = "https://clients.plex.tv/api/v2/resources?includeHttps=1&includeRelay=1&includeIPv6=1"


def fetch_servers(client_id, token):
    resources = http(RESOURCES_URL, client_headers(client_id, token), timeout=10)
    return [r for r in resources if "server" in (r.get("provides") or "")]


def ranked_uris(server):
    """Connection URIs in preference order: local, then remote, then Plex relay."""
    conns = sorted(server.get("connections") or [], key=lambda c: (bool(c.get("relay")), not c.get("local")))
    for c in conns:
        kind = "relay" if c.get("relay") else "local" if c.get("local") else "remote"
        log.info("  candidate %-6s %s", kind, c["uri"])
    return [c["uri"] for c in conns]


def probe(uris, client_id, token, timeout=4):
    """Try every address at once; return the most preferred one that answers, or None."""
    if not uris:
        return None
    log.info("probing %d address(es)", len(uris))
    headers = client_headers(client_id, token)
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=len(uris))
    futures = {pool.submit(http, uri.rstrip("/") + "/identity", headers, timeout=timeout): uri for uri in uris}
    working, pending = set(), set(futures)
    deadline = time.monotonic() + timeout + 1
    try:
        while pending and time.monotonic() < deadline:
            done, pending = concurrent.futures.wait(pending, timeout=deadline - time.monotonic(), return_when="FIRST_COMPLETED")
            working |= {futures[f] for f in done if f.exception() is None}
            if working:
                if uris[0] in working:
                    break
                # a less preferred address answered: give better ones a moment longer
                deadline = min(deadline, time.monotonic() + 1)
    finally:
        pool.shutdown(wait=False, cancel_futures=True)
    best = next((uri for uri in uris if uri in working), None)
    log.info("probe result: %s", best or "no address answered")
    return best


def rediscover(cfg):
    """Ask plex.tv for the server's current addresses and pick one that works.

    Returns the updated config (already saved) or raises PlexError.
    """
    client_id = cfg["client_id"]
    token = cfg.get("account_token") or cfg["token"]
    saved = cfg.get("connections") or []
    uri = probe(saved, client_id, cfg["token"]) if saved else None
    if not uri:
        log.info("asking plex.tv for %s's current addresses", cfg.get("server_name"))
        servers = fetch_servers(client_id, token)
        machine = cfg.get("machine_id")
        server = next(
            (s for s in servers if (machine and s.get("clientIdentifier") == machine) or s.get("name") == cfg.get("server_name")),
            None,
        )
        if not server:
            raise PlexError(f"{cfg.get('server_name', 'server')} isn't on your Plex account anymore — run `plexi login`")
        saved = ranked_uris(server)
        cfg.update(connections=saved, machine_id=server.get("clientIdentifier", ""), token=server.get("accessToken") or cfg["token"])
        uri = probe(saved, client_id, cfg["token"])
    if not uri:
        raise ConnectionFailed(f"none of {cfg.get('server_name', 'the server')}'s {len(saved)} addresses answered")
    if uri != cfg.get("server"):
        log.info("switching server address %s → %s", cfg.get("server"), uri)
    cfg["server"] = uri
    save_config(cfg)
    return cfg


def login(theme):
    accent, dim, fg = theme.fg("accent"), theme.fg("light_foreground"), theme.fg("foreground")
    cfg = load_config()
    client_id = cfg.get("client_id") or str(uuid.uuid4())
    headers = client_headers(client_id)

    pin = http("https://plex.tv/api/v2/pins?strong=true", headers, method="POST")
    auth_url = "https://app.plex.tv/auth#?" + urllib.parse.urlencode(
        {"clientID": client_id, "code": pin["code"], "context[device][product]": PRODUCT}
    )
    print(f"\n  {accent}{BOLD}plexi{RESET}{fg} — sign in to Plex in your browser{RESET}")
    print(f"  {dim}{auth_url}{RESET}\n")
    try:
        subprocess.Popen(["xdg-open", auth_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass

    print(f"  {dim}waiting for approval…{RESET}", flush=True)
    token, deadline = None, time.monotonic() + 300
    while not token and time.monotonic() < deadline:
        time.sleep(2)
        token = http(f"https://plex.tv/api/v2/pins/{pin['id']}", headers).get("authToken")
    if not token:
        raise PlexError("sign-in timed out")

    servers = fetch_servers(client_id, token)
    if not servers:
        raise PlexError("no Plex Media Server found on this account")

    server = servers[0]
    if len(servers) > 1:
        print()
        for i, s in enumerate(servers, 1):
            print(f"  {accent}{i}{RESET}  {fg}{s['name']}{RESET}")
        while True:
            choice = input(f"\n  {dim}server [1]:{RESET} ").strip() or "1"
            if choice.isdigit() and 1 <= int(choice) <= len(servers):
                server = servers[int(choice) - 1]
                break

    server_token = server.get("accessToken") or token
    log.info("signed in; server %s (%s)", server["name"], server.get("clientIdentifier"))
    uris = ranked_uris(server)
    print(f"  {dim}trying {plural(len(uris), 'address')} for {server['name']}…{RESET}", flush=True)
    uri = probe(uris, client_id, server_token)

    cfg.update(
        server=uri or (uris[0] if uris else ""),
        token=server_token,
        account_token=token,
        server_name=server["name"],
        machine_id=server.get("clientIdentifier", ""),
        connections=uris,
        client_id=client_id,
    )
    save_config(cfg)
    if not uri:
        raise ConnectionFailed(f"signed in, but none of {server['name']}'s addresses answered (see `plexi log`)")
    print(f"  {theme.fg('green')}✓{RESET} {fg}signed in to {server['name']} via {uri}{RESET}\n")
    return cfg


