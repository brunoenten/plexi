        "X-Plex-Device": "Linux",
        "X-Plex-Device-Name": socket.gethostname(),
    }
    if token:
        headers["X-Plex-Token"] = token
    return headers


_create_connection = socket.create_connection


def happy_connect(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, *args, **kwargs):
    """Race IPv6 and IPv4 addresses (RFC 8305 style), so a broken IPv6 route
    doesn't stall every request until it times out."""
    host, port = address[:2]
    try:
        infos = socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM)
    except OSError:
        infos = []
    if len(infos) < 2:
        return _create_connection(address, timeout, source_address, *args, **kwargs)
    v6 = [i for i in infos if i[0] == socket.AF_INET6]
    v4 = [i for i in infos if i[0] != socket.AF_INET6]
    ordered = [i for pair in zip(v6 + [None] * len(v4), v4 + [None] * len(v6)) for i in pair if i]
    limit = None if timeout is socket._GLOBAL_DEFAULT_TIMEOUT else timeout
    results, lock, state = queue.Queue(), threading.Lock(), {"done": False}

    def attempt(info):
        family, kind, proto, _, addr = info
        sock = socket.socket(family, kind, proto)
        try:
            sock.settimeout(limit)
            if source_address:
                sock.bind(source_address)
            sock.connect(addr)
        except OSError as e:
            sock.close()
            results.put((None, e))
            return
        with lock:
            if state["done"]:
                sock.close()
                return
            state["done"] = True
        log.debug("connected to %s via %s", host, addr[0])
        results.put((sock, None))

    deadline = time.monotonic() + (limit or 30)
    errors, started = [], 0
    try:
        for info in ordered:
            threading.Thread(target=attempt, args=(info,), daemon=True).start()
            started += 1
            try:
                sock, err = results.get(timeout=0.25)
            except queue.Empty:
                continue
            if sock:
                return sock
            errors.append(err)
        while len(errors) < started and time.monotonic() < deadline:
            try:
                sock, err = results.get(timeout=max(0.01, deadline - time.monotonic()))
            except queue.Empty:
                break
            if sock:
                return sock
            errors.append(err)
    finally:
        with lock:
            state["done"] = True
    raise errors[-1] if errors else TimeoutError("timed out")


socket.create_connection = happy_connect


class ConnectionFailed(PlexError):
    """The server didn't answer at all (DNS, refused, timeout, TLS) — another address may work."""


class Cancelled(PlexError):
    pass


def http(url, headers, method="GET", timeout=8, parse=True):
    req = urllib.request.Request(url, method=method, headers=headers, data=b"" if method == "POST" else None)
    host = urllib.parse.urlsplit(url).netloc
    started = time.monotonic()
    elapsed = lambda: f"{(time.monotonic() - started) * 1000:.0f}ms"
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
    except urllib.error.HTTPError as e:
        log.warning("%s %s → HTTP %s in %s", method, redact(url), e.code, elapsed())
        hint = " (token rejected — run `plexi login`)" if e.code == 401 else ""
        raise PlexError(f"HTTP {e.code} from {host}{hint}") from e
    except (urllib.error.URLError, OSError, HTTPException, ValueError) as e:
        reason = getattr(e, "reason", None) or e
        log.warning("%s %s ✗ %s after %s", method, redact(url), reason, elapsed())
        raise ConnectionFailed(f"can't reach {host}: {reason}") from e
    log.info("%s %s → %s in %s", method, redact(url), resp.status, elapsed())
    if not parse or not body.strip():
        return {}
    try:
        return json.loads(body)
    except ValueError as e:
        raise PlexError(f"unexpected response from {host}") from e


class Plex:
    def __init__(self, url, token, client_id):
        self.url = url.rstrip("/")
        self.token = token
        self.headers = client_headers(client_id, token)

    def _url(self, path, params):
        return self.url + path + ("?" + urllib.parse.urlencode(params) if params else "")

    def get(self, path, **params):
        return http(self._url(path, params), self.headers).get("MediaContainer", {})

    def call(self, path, **params):
        http(self._url(path, params), self.headers, parse=False)

    def sections(self):
        dirs = self.get("/library/sections").get("Directory", [])
        return [d for d in dirs if d.get("type") in ("movie", "show")]

    def continue_watching(self):
        try:
            items = self.get("/hubs/continueWatching/items").get("Metadata", [])
        except ConnectionFailed:
            raise
        except PlexError:
            items = self.get("/library/onDeck").get("Metadata", [])
        return [i for i in items if i.get("type") in PLAYABLE]

    def recently_added(self, limit=50):
        paging = {"X-Plex-Container-Start": 0, "X-Plex-Container-Size": limit}
        items = self.get("/library/recentlyAdded", **paging).get("Metadata", [])
        return [i for i in items if i.get("type") in BROWSABLE][:limit]

    def items(self, section_key):
        return self.get(f"/library/sections/{section_key}/all").get("Metadata", [])

    def children(self, rating_key):
        return self.get(f"/library/metadata/{rating_key}/children", excludeAllLeaves=1).get("Metadata", [])

    def metadata(self, rating_key):
        found = self.get(f"/library/metadata/{rating_key}").get("Metadata") or [None]
        return found[0]

    def stream_url(self, item):
        part = item["Media"][0]["Part"][0]["key"]
        return self._url(part, {"X-Plex-Token": self.token})

    def scrobble(self, rating_key, watched=True):
        path = "/:/scrobble" if watched else "/:/unscrobble"
        self.call(path, identifier="com.plexapp.plugins.library", key=rating_key)

    def timeline(self, item, state, time_ms):
        rk = item["ratingKey"]
        self.call(
            "/:/timeline",
            ratingKey=rk,
            key=f"/library/metadata/{rk}",
            state=state,
            time=int(time_ms),
            duration=int(item.get("duration") or 0),
        )


