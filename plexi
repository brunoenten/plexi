class Passthrough:
    def __init__(self, device, sink, codecs, declared_now=False, busy=(), channels=2):
        self.device, self.sink, self.codecs, self.declared_now = device, sink, codecs, declared_now
        # PipeWire only links a bitstream to an output nothing else is connected to
        self.busy = list(busy)
        self.channels = channels

    def plan(self, media):
        """(extra mpv args, description) for how a title's main audio track reaches the receiver."""
        codec = stream_codec(media)
        name = (media.get("audioCodec") or "audio").upper()
        if self.busy:
            return [], f"{name} decoded, {', '.join(self.busy)} holds"
        args = ["--ao=pipewire", f"--audio-spdif={','.join(self.codecs)}"]
        if codec in self.codecs:
            return args, f"bitstream {SPDIF[codec][3]}"
        if codec == "dts-hd" and "dts" in self.codecs:
            return args, "bitstream DTS core"
        channels = int(media.get("audioChannels") or 0)
        # a stereo PCM output would downmix surround; a Dolby Digital bitstream keeps 5.1
        if channels > 2 and self.channels <= 2 and "ac3" in self.codecs:
            return args + ["--af=lavcac3enc"], f"{name} re-encoded to Dolby Digital"
        return args, f"{name} decoded"


def stream_codec(media):
    """The mpv --audio-spdif name for a Plex media's primary audio codec, if it's a bitstream format."""
    codec = (media.get("audioCodec") or "").lower()
    if codec in ("dca", "dts", "dca-ma"):
        return "dts-hd" if codec == "dca-ma" or (media.get("audioProfile") or "").lower() in ("ma", "hra") else "dts"
    return codec if codec in SPDIF else None


def parse_eld(text):
    """Return (monitor_name, set of ELD codec names) for a connected HDMI sink, or None."""
    fields = {}
    for line in text.splitlines():
        key, _, value = line.partition("\t")
        fields[key.strip()] = value.strip()
    if fields.get("monitor_present") != "1" or fields.get("eld_valid") != "1":
        return None
    codecs = set()
    for key, value in fields.items():
        if key.startswith("sad") and key.endswith("_coding_type"):
            m = re.match(r"\[0x[0-9a-f]+\]\s*([^/(]+)", value)
            if m:
                codecs.add(m.group(1).strip())
    return fields.get("monitor_name", ""), codecs


def pipewire_default_sink():
    """The default audio sink's name, description, ALSA card/path and declared iec958 codecs."""
    objects = json.loads(subprocess.run(["pw-dump"], capture_output=True, timeout=3, check=True).stdout)
    name = None
    for obj in objects:
        if obj.get("type") == "PipeWire:Interface:Metadata" and (obj.get("props") or {}).get("metadata.name") == "default":
            for entry in obj.get("metadata") or []:
                if entry.get("key") == "default.audio.sink":
                    value = entry.get("value")
                    name = (value if isinstance(value, dict) else json.loads(value or "{}")).get("name")
    nodes = {obj["id"]: obj for obj in objects if obj.get("type") == "PipeWire:Interface:Node"}
    for node_id, obj in nodes.items():
        info = obj.get("info") or {}
        props = info.get("props") or {}
        if name and props.get("node.name") == name:
            declared = []
            for param in (info.get("params") or {}).get("Props") or []:
                declared = param.get("iec958Codecs") or declared
            users = set()
            for link in objects:
                link_info = link.get("info") or {}
                if link.get("type") == "PipeWire:Interface:Link" and link_info.get("input-node-id") == node_id:
                    peer = ((nodes.get(link_info.get("output-node-id")) or {}).get("info") or {}).get("props") or {}
                    users.add(peer.get("application.name") or peer.get("node.description") or peer.get("node.name") or "another app")
            return {
                "name": name,
                "description": props.get("node.description", ""),
                "card": props.get("alsa.card"),
                "path": str(props.get("api.alsa.path", "")),
                "iec958": declared,
                "users": sorted(users),
                "channels": int(props.get("audio.channels") or 2),
            }
    return None


def detect_passthrough(only=None):
    """Bitstream formats the default output's HDMI receiver accepts, declaring missing ones in PipeWire.

    `only` limits them to a set of mpv --audio-spdif names, for links that advertise more than they carry.
    """
    try:
        sink = pipewire_default_sink()
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        log.debug("audio: can't query PipeWire (%s); no passthrough", e)
        return None
    if not sink or not sink["path"].startswith("hdmi") or sink["card"] is None:
        log.debug("audio: default output %s isn't HDMI; no passthrough", sink["name"] if sink else "unknown")
        return None

    receivers = []
    for path in sorted(glob.glob(f"/proc/asound/card{sink['card']}/eld#*")):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                parsed = parse_eld(f.read())
        except OSError:
            continue
        if parsed:
            receivers.append(parsed)
    if not receivers:
        log.debug("audio: no HDMI device reports ELD data on card %s; no passthrough", sink["card"])
        return None
    device, eld_codecs = next((r for r in receivers if r[0] and r[0] in sink["description"]), receivers[0])
    supported = [c for c, spec in SPDIF.items() if spec[0] in eld_codecs and (only is None or c in only)]
    log.debug("audio: %s on %s advertises %s", device or "HDMI device", sink["name"], ", ".join(sorted(eld_codecs)) or "nothing")
    if not supported:
        return None

    declared_now = False
    if any(SPDIF[c][1] not in sink["iec958"] for c in supported):
        formats = "; ".join(["pcm"] + [SPDIF[c][2] for c in supported])
        try:
            sinks = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True, timeout=3, check=True).stdout
            index = next(line.split("\t")[0] for line in sinks.splitlines() if line.split("\t")[1:2] == [sink["name"]])
            subprocess.run(["pactl", "set-sink-formats", index, formats], capture_output=True, timeout=3, check=True)
            log.info("audio: declared passthrough formats on %s: %s", sink["name"], formats)
            sink = pipewire_default_sink() or sink
            declared_now = True
        except (OSError, subprocess.SubprocessError, ValueError, StopIteration) as e:
            log.warning("audio: couldn't declare passthrough formats on %s (%s)", sink["name"], e or "sink not found")

    codecs = [c for c in supported if SPDIF[c][1] in sink["iec958"]]
    if not codecs:
        return None
    return Passthrough(device or sink["description"], sink["name"], codecs, declared_now, sink["users"], sink["channels"])


# ── video: HDR and refresh rate ──────────────────────────────────────────

# Plex's coarse videoFrameRate labels, for when the stream's exact rate isn't known
FRAME_RATES = {"24p": 23.976, "ntsc": 29.97, "pal": 25.0, "50p": 50.0, "60p": 59.94}


def video_stream(media):
    """The video stream of a Plex media, {} if it has none, or None if streams weren't loaded."""
    streams = (media.get("Part") or [{}])[0].get("Stream")
    if streams is None:
        return None
    return next((s for s in streams if s.get("streamType") == 1), {})


def video_info(media):
    """(HDR kind or None, frames per second or None) for a Plex media."""
    video = video_stream(media) or {}
    trc = (video.get("colorTrc") or "").lower()
    # Dolby Vision profile 5 has no HDR10 base layer and reports no transfer curve
    if video.get("DOVIPresent"):
        hdr = "Dolby Vision"
    elif trc == "smpte2084":
        hdr = "HDR10"
    elif trc == "arib-std-b67":
        hdr = "HLG"
    else:
        hdr = None
    fps = video.get("frameRate")
    if not isinstance(fps, (int, float)) or fps <= 0:
        fps = FRAME_RATES.get(str(media.get("videoFrameRate") or "").lower())
    return hdr, fps


def fmt_fps(fps):
    return f"{fps:.3f}".rstrip("0").rstrip(".")


def true_rate(rate):
    """Hyprland lists 23.976 Hz as 23.98, 59.94 as 59.94, etc.; recover the 1000/1001 rate."""
    ntsc = round(rate) / 1.001
    return ntsc if abs(rate - ntsc) < 0.006 else rate


def pick_rate(rates, fps):
    """The refresh rate that shows fps as an exact multiple (no judder), preferring the higher one; or None."""
    best = None
    for rate in rates:
        # 100/120 Hz modes add nothing for video and push 4K 10-bit HDMI to its bandwidth limit
        if rate > 61:
            continue
        actual = true_rate(rate)
        k = round(actual / fps)
        if k < 1:
            continue
        error = abs(actual / k - fps)
        if error < 0.025 and (best is None or (round(error, 3), -rate) < best[0]):
            best = ((round(error, 3), -rate), rate)
    return best[1] if best else None


class Display:
    """A Hyprland monitor's mode, as reported by hyprctl and re-applied through hl.monitor()."""

    def __init__(self, mon):
        self.name = mon["name"]
        self.width, self.height = mon["width"], mon["height"]
        self.rate = mon["refreshRate"]
        self.ten_bit = "2101010" in (mon.get("currentFormat") or "")
        self.position = f"{mon['x']}x{mon['y']}"
        self.scale = mon["scale"]
        self.transform = mon.get("transform") or 0
        prefix = f"{self.width}x{self.height}@"
        self.rates = sorted({float(m[len(prefix):].rstrip("Hz")) for m in mon.get("availableModes") or [] if m.startswith(prefix)})
        self.vrr_range = None

    def vrr_covers(self, fps):
        """Whether VRR can show fps (or a multiple of it) within the display's range at the current mode."""
        if not self.vrr_range:
            return False
        low, high = self.vrr_range[0], min(self.vrr_range[1], self.rate + 0.5)
        return any(low <= fps * k <= high for k in range(1, 9))

    def mode(self, rate):
        return f"{self.width}x{self.height}@{rate:.2f}"

    def spec(self, rate, ten_bit):
        return (
            f'hl.monitor({{ output = "{self.name}", mode = "{self.mode(rate)}", position = "{self.position}", '
            f"scale = {self.scale:g}, transform = {self.transform}, bitdepth = {10 if ten_bit else 8} }})"
        )

    def apply(self, rate, ten_bit):
        out = subprocess.run(["hyprctl", "eval", self.spec(rate, ten_bit)], capture_output=True, text=True, timeout=5, check=True)
        if out.stdout.strip() != "ok":
            raise subprocess.SubprocessError(out.stdout.strip() or out.stderr.strip())


def edid_vrr_range(output):
    """(min, max) Hz of the HDMI VRR range in a connector's EDID (HDMI Forum data block), or None."""
    for path in glob.glob(f"/sys/class/drm/card*-{output}/edid"):
        try:
            with open(path, "rb") as f:
                edid = f.read()
        except OSError:
            continue
        for base in range(128, len(edid), 128):
            block = edid[base:base + 128]
            if len(block) < 4 or block[0] != 2:
                continue
            i = 4
            while i < min(block[2], len(block)):
                tag, length = block[i] >> 5, block[i] & 31
                body = block[i + 1:i + 1 + length]
                if tag == 3 and body[:3] == b"\xd8\x5d\xc4" and len(body) >= 10:
                    low, high = body[8] & 0x3F, ((body[8] & 0xC0) << 2) | body[9]
                    if low and high > low:
                        return low, high
                i += 1 + length
    return None


def current_display():
    """The focused Hyprland monitor, or None outside Hyprland."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or not shutil.which("hyprctl"):
        return None
    try:
        run = lambda *cmd: json.loads(subprocess.run(["hyprctl", *cmd, "-j"], capture_output=True, timeout=3, check=True).stdout)
        mons = run("monitors")
        mon = next((m for m in mons if m.get("focused")), mons[0] if mons else None)
        if not mon:
            return None
        display = Display(mon)
        # any misc:vrr mode (always, fullscreen, fullscreen video) covers fullscreen mpv
        if run("getoption", "misc:vrr").get("int"):
            display.vrr_range = edid_vrr_range(display.name)
        return display
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as e:
        log.debug("display: can't query Hyprland (%s)", e)
        return None


