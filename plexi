class MpvIPC:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(1)
        self.sock.connect(path)
        self.buf = b""
        self.rid = 0

    def get(self, prop):
        self.rid += 1
        msg = {"command": ["get_property", prop], "request_id": self.rid}
        self.sock.sendall(json.dumps(msg).encode() + b"\n")
        while True:
            while b"\n" not in self.buf:
                chunk = self.sock.recv(4096)
                if not chunk:
                    raise OSError("mpv closed the socket")
                self.buf += chunk
            line, self.buf = self.buf.split(b"\n", 1)
            reply = json.loads(line)
            if reply.get("request_id") == self.rid:
                return reply.get("data") if reply.get("error") == "success" else None

    def close(self):
        self.sock.close()


class Player(threading.Thread):
    """Runs mpv for one item and reports progress back to Plex."""

    def __init__(self, app, node, offset_ms, previous=None):
        super().__init__(daemon=True)
        self.app, self.node, self.offset, self.previous = app, node, offset_ms, previous
        self.title = node.media_title()
        self.proc = None
        self.stopped = False
        self.created = time.monotonic()

    @property
    def starting(self):
        return self.is_alive() and self.proc is None and not self.stopped

    def just_started(self, node):
        return self.is_alive() and self.node is node and time.monotonic() - self.created < 5

    def stop(self):
        self.stopped = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def run(self):
        plex, item = self.app.plex, self.node.data
        sock = os.path.join(tempfile.gettempdir(), f"plexi-{os.getpid()}-{item['ratingKey']}.sock")
        try:
            url = plex.stream_url(item)
        except (KeyError, IndexError):
            self.app.events.put(("error", "nothing playable for this item"))
            return
        cmd = [
            "mpv",
            "--force-window=immediate",
            "--fs",
            f"--force-media-title={self.title}",
            f"--input-ipc-server={sock}",
            f"--start={self.offset / 1000:.3f}",
        ]
        if self.previous and self.previous.proc:
            try:
                self.previous.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass

        media = (item.get("Media") or [{}])[0]
        if video_stream(media) is None:
            try:
                media = ((plex.metadata(item["ratingKey"]) or {}).get("Media") or [media])[0]
            except PlexError:
                pass
        hdr, fps = video_info(media)
        sync, switched = self.app.match_display(hdr if self.app.hdr else None, fps)
        if switched:
            # the HDMI link (and the receiver behind it) resyncs after a mode change
            time.sleep(2)
        if isinstance(sync, float):
            cmd.append("--video-sync=display-resample")
        if hdr and self.app.hdr:
            # Hyprland switches the output to HDR for a fullscreen window that asks for it,
            # using the film's own mastering metadata
            cmd += ["--vo=gpu-next", "--target-colorspace-hint=yes", "--target-colorspace-hint-mode=source"]
        log.info(
            "video: %s%s%s",
            (hdr if self.app.hdr else f"{hdr} tone-mapped to SDR") if hdr else "SDR",
            f" {fmt_fps(fps)} fps" if fps else "",
            ", display VRR" if sync == "vrr" else f", display {sync:g} Hz" if sync else ", display unchanged",
        )

        audio = self.app.refresh_audio()
        if audio and audio.busy:
            who = ", ".join(audio.busy)
            log.info("audio: %s is in use by %s; decoded instead of passthrough", audio.device, who)
            self.app.events.put(("info", f"{who} is using {audio.device} — playing decoded audio (close it for passthrough)"))
        elif audio:
            args, route = audio.plan(media)
            cmd += args
            log.info("audio: %s → %s via %s (passthrough %s)", route, audio.device, audio.sink, ",".join(audio.codecs))
        else:
            log.info("audio: decoded (no passthrough)")
        cmd += ["--", url]
        if self.stopped:
            log.info("superseded before mpv started: %s", self.title)
            return
        log.info("mpv: %s (from %s)", redact(url), fmt_clock(self.offset))
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except FileNotFoundError:
            self.app.restore_display()
            self.app.events.put(("error", "mpv not found — install it with `omarchy pkg add mpv`"))
            return

        pos, paused, ipc, last_report = self.offset / 1000, False, None, 0.0
        while self.proc.poll() is None:
            time.sleep(1)
            try:
                ipc = ipc or MpvIPC(sock)
                p = ipc.get("time-pos")
                if isinstance(p, (int, float)):
                    pos = p
                paused = bool(ipc.get("pause"))
            except (OSError, ValueError):
                ipc = None
            if time.monotonic() - last_report >= 10:
                last_report = time.monotonic()
                try:
                    plex.timeline(item, "paused" if paused else "playing", pos * 1000)
                except PlexError:
                    pass

        log.info("mpv exited with %s at %s", self.proc.returncode, fmt_clock(pos * 1000))
        if self.app.player is self:
            self.app.restore_display()
        if ipc:
            ipc.close()
        try:
            os.unlink(sock)
        except OSError:
            pass
        duration = item.get("duration") or 0
        try:
            plex.timeline(item, "stopped", pos * 1000)
            if duration and pos * 1000 >= duration * 0.9:
                plex.scrobble(item["ratingKey"])
        except PlexError:
            pass
        self.app.events.put(("played", self.node))


# ── input ────────────────────────────────────────────────────────────────

ESCAPES = {
    b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
    b"OA": "up", b"OB": "down", b"OC": "right", b"OD": "left",
    b"[H": "home", b"[F": "end", b"OH": "home", b"OF": "end",
    b"[1~": "home", b"[4~": "end", b"[5~": "pgup", b"[6~": "pgdn",
}
CONTROLS = {3: "ctrl-c", 4: "ctrl-d", 21: "ctrl-u", 9: "tab"}


def read_key(fd):
    b = os.read(fd, 1)
    if not b:
        return None
    c = b[0]
    if c == 0x1B:
        if not select.select([fd], [], [], 0.03)[0]:
            return "esc"
        return ESCAPES.get(os.read(fd, 8))
    if c in (10, 13):
        return "enter"
    if c in (8, 127):
        return "backspace"
    if c < 32:
        return CONTROLS.get(c)
    extra = 0 if c < 0x80 else 1 if c >> 5 == 0b110 else 2 if c >> 4 == 0b1110 else 3
    if extra:
        b += os.read(fd, extra)
    return b.decode("utf-8", "replace")


# ── app ──────────────────────────────────────────────────────────────────

HINTS = [
    ("j/k", "move"), ("l", "open"), ("h", "back"), ("enter", "play"),
    ("p", "from start"), ("w", "watched"), ("/", "find"), ("r", "reload"), ("q", "quit"),
]
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


class App:
    def __init__(self, plex, cfg, fixed_server=False):
        self.plex = plex
        self.cfg = cfg
        self.fixed_server = fixed_server
        self.server_name = cfg.get("server_name") or urllib.parse.urlsplit(plex.url).hostname or "plex"
        self.activity = None
        self.error = None
        enabled = lambda env, key: str(os.environ.get(env) or cfg.get(key) or "auto").lower() != "off"
        self.passthrough = enabled("PLEXI_PASSTHROUGH", "passthrough")
        mode = str(os.environ.get("PLEXI_PASSTHROUGH") or cfg.get("passthrough") or "auto").lower()
        self.passthrough_only = None if mode in ("auto", "off") else {c.strip() for c in mode.split(",") if c.strip()}
        self.hdr = enabled("PLEXI_HDR", "hdr")
        refresh = str(os.environ.get("PLEXI_REFRESH") or cfg.get("match_refresh") or "auto").lower()
        self.match_refresh = refresh != "off"
        self.prefer_vrr = refresh != "switch"
        self.audio = None
        self.display = None
        self.display_saved = None
        self.display_lock = threading.Lock()
        self.devices_checked = float("-inf")
        self.theme = Theme()
        self.root = Node({}, "root", None)
        self.root.expanded = True
        self.sel = None
        self.top = 0
        self.status = ("", "foreground", 0.0, 0)
        self.search = None
        self.search_origin = None
        self.last_search = ""
        self.revealed = []
        self.events = queue.Queue()
        self.player = None
        self.running = True
        self.resized = True
        self.body_height = 10
        self.fd = sys.stdin.fileno()

    # lifecycle

    def run(self):
        saved = termios.tcgetattr(self.fd)
        signal.signal(signal.SIGWINCH, lambda *_: setattr(self, "resized", True))
        for sig in (signal.SIGHUP, signal.SIGTERM):
            signal.signal(sig, lambda *_: sys.exit(0))
        try:
            tty.setraw(self.fd)
            self.write("\x1b[?1049h\x1b[?25l")
            self.load(self.root)
            while self.running:
                self.theme.reload()
                if time.monotonic() - self.devices_checked > 15:
                    self.devices_checked = time.monotonic()
                    threading.Thread(target=self.refresh_devices, daemon=True).start()
                self.drain_events()
                self.render()
                if select.select([self.fd], [], [], 0.25)[0]:
                    key = read_key(self.fd)
                    if key:
                        self.handle(key)
        except Exception:
            log.exception("crashed")
            raise
        finally:
            player = self.player
            self.restore_display(after=player.proc if player and player.is_alive() else None)
            try:
                self.write(RESET + "\x1b[?25h\x1b[?1049l")
                termios.tcsetattr(self.fd, termios.TCSADRAIN, saved)
            except (OSError, termios.error):
                pass

    def write(self, s):
        sys.stdout.write(s)
        sys.stdout.flush()

    def flash(self, text, color="foreground", ttl=4):
        self.status = (text, color, time.monotonic(), ttl)

    def refresh_audio(self):
        """Detect HDMI passthrough for the current default output. Safe to call from any thread."""
        if not self.passthrough:
            self.audio = None
            return None
        audio = detect_passthrough(self.passthrough_only)
        if audio and audio.declared_now:
            self.events.put(("info", f"enabled DTS/Dolby passthrough on {audio.device}"))
        summary = lambda a: (a.device, a.sink, tuple(a.codecs), tuple(a.busy)) if a else None
        if summary(audio) != summary(self.audio):
            if audio:
                busy = f", in use by {', '.join(audio.busy)}" if audio.busy else ""
                log.info("audio: %s on %s supports passthrough of %s%s", audio.device, audio.sink, ",".join(audio.codecs), busy)
            else:
                log.info("audio: no passthrough-capable HDMI output")
        self.audio = audio
        return audio

    def refresh_devices(self):
        if self.passthrough:
            self.refresh_audio()
        if self.hdr or self.match_refresh:
            self.display = current_display()

    def refresh_for(self, display, fps):
        """How fps will be shown on display: "vrr", a refresh rate to switch to, or None."""
        if not (display and fps and self.match_refresh):
            return None
        if self.prefer_vrr and display.vrr_covers(fps):
            return "vrr"
        return pick_rate(display.rates, fps)

    def match_display(self, hdr, fps):
        """Switch the display to fps's refresh rate (and 10-bit for HDR) before playback.

        Returns ("vrr", the matched rate or None; whether the mode changed). Safe to call from any thread.
        """
        with self.display_lock:
            current = current_display()
            if not current:
                return None, False
            self.display = current
            base = self.display_saved or current
            sync = self.refresh_for(base, fps)
            rate = sync if isinstance(sync, float) else None
            target_rate, ten_bit = rate or base.rate, bool(hdr) or base.ten_bit
            if abs(target_rate - current.rate) < 0.005 and ten_bit == current.ten_bit:
                return sync, False
            try:
                current.apply(target_rate, ten_bit)
            except (OSError, subprocess.SubprocessError) as e:
                log.warning("display: couldn't switch %s to %s (%s)", current.name, current.mode(target_rate), e)
                return None, False
            self.display_saved = base
            depth = ", 10-bit" if ten_bit else ""
            log.info("display: %s %s → %s%s", current.name, current.mode(current.rate), current.mode(target_rate), depth)
            self.events.put(("info", f"{current.name} → {target_rate:g} Hz{depth}" + (f" for {hdr}" if hdr else "")))
            return sync, True

    def restore_display(self, after=None):
        """Put the display back the way it was before playback; after mpv exits if `after` is still running."""
        with self.display_lock:
            saved, self.display_saved = self.display_saved, None
            if not saved:
                return
            spec = saved.spec(saved.rate, saved.ten_bit)
            if after and after.poll() is None:
                # plexi is quitting while mpv keeps playing: restore once mpv is gone
                subprocess.Popen(
                    ["sh", "-c", 'while kill -0 "$1" 2>/dev/null; do sleep 1; done; exec hyprctl eval "$2"', "sh", str(after.pid), spec],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                )
                log.info("display: %s will be restored to %s when mpv exits", saved.name, saved.mode(saved.rate))
                return
            try:
                saved.apply(saved.rate, saved.ten_bit)
                log.info("display: restored %s to %s", saved.name, saved.mode(saved.rate))
            except (OSError, subprocess.SubprocessError) as e:
                log.warning("display: couldn't restore %s (%s)", saved.name, e)

    def fetch_details(self, node):
        try:
            self.events.put(("details", (node, self.plex.metadata(node.key))))
        except PlexError as e:
            log.debug("details for %s: %s", node.key, e)

    def fail(self, error, node=None):
        log.error("%s", error)
        self.flash(str(error), "red", ttl=10)
        if node is self.root:
            self.error = str(error)

    def drain_events(self):
        while True:
            try:
                kind, value = self.events.get_nowait()
            except queue.Empty:
                return
            if kind == "error":
                self.fail(value)
            elif kind == "info":
                self.flash(value, "green", ttl=6)
            elif kind == "details":
                node, data = value
                node.data = data or node.data
            elif kind == "played":
                self.refresh_meta(value)

    # network

    @property
    def host(self):
        return urllib.parse.urlsplit(self.plex.url).netloc

    def busy(self, label, fn):
        """Run fn on a worker thread while keeping the UI drawn; esc/q cancels."""
        box = {}

        def target():
            try:
                box["value"] = fn()
            except BaseException as e:
                box["error"] = e

        worker = threading.Thread(target=target, daemon=True)
        self.activity = [label, time.monotonic()]
        worker.start()
        try:
            while worker.is_alive():
                self.render()
                if select.select([self.fd], [], [], 0.1)[0] and read_key(self.fd) in ("esc", "q", "ctrl-c"):
                    log.info("cancelled: %s", self.activity[0])
                    raise Cancelled("cancelled")
        finally:
            self.activity = None
        if "error" in box:
            raise box["error"]
        return box.get("value")

    def switch(self, cfg):
        self.cfg = cfg
        self.plex = Plex(cfg["server"], cfg["token"], cfg["client_id"])

    def net(self, label, fn):
        """A Plex call with spinner, cancel, and failover to another server address."""

        def work():
            try:
                return fn()
            except ConnectionFailed as e:
                if self.fixed_server:
                    raise
                log.warning("%s — looking for another address", e)
                self.activity[0] = f"{self.host} isn't answering — trying other addresses"
                try:
                    self.switch(rediscover(self.cfg))
                except PlexError as again:
                    log.error("failover failed: %s", again)
                    raise ConnectionFailed(f"{e} — and no other address answered") from again
                self.activity[0] = f"{label} via {self.host}"
                return fn()

        return self.busy(label, work)

    def reconnect(self):
        if self.fixed_server:
            self.flash("PLEX_URL is set — not switching addresses", "yellow")
            return

        def work():
            cfg = dict(self.cfg)
            cfg.pop("connections", None)
            self.switch(rediscover(cfg))

        try:
            self.busy("asking plex.tv for the server's addresses", work)
        except Cancelled:
            self.flash("cancelled", "light_foreground")
            return
        except PlexError as e:
            self.fail(e, self.root if not self.root.children else None)
            return
        self.flash(f"connected via {self.host}", "green")
        self.reload(self.root)

    # data

    def fetch(self, node):
        if node.kind == "root":
            return HUBS + self.plex.sections()
        if node.kind == "hub":
            return self.plex.continue_watching() if node.data["hub"] == "continue" else self.plex.recently_added()
        if node.kind == "section":
            return self.plex.items(node.data["key"])
        return self.plex.children(node.key)

    def load(self, node, force=False):
        if node.children is not None and not force:
            return True
        label = f"connecting to {self.host}" if node is self.root else f"loading {node.data.get('title', '')}"
        try:
            items = self.net(label, lambda: self.fetch(node))
        except Cancelled:
            self.flash("cancelled", "light_foreground")
            if node is self.root:
                self.error = "connection cancelled"
            return False
        except PlexError as e:
            self.fail(e, node)
            return False
        if node is self.root:
            self.error = None
        existing = {c.key: c for c in node.children or []}
        children = []
        for data in items:
            child = existing.get(data.get("ratingKey") or data.get("key"))
            if child:
                child.data = data
            else:
                if "hub" in data:
                    kind = "hub"
                elif node.kind == "root":
                    kind = "section"
                else:
                    kind = data.get("type")
                child = Node(data, kind, node)
            children.append(child)
        node.children = children
        self.flash("" if children else "nothing here", "light_foreground")
        return True

    def reload(self, node):
        if not self.load(node, force=True):
            return False
        for child in node.children:
            if child.expanded:
                self.reload(child)
        return True

    def refresh_meta(self, node):
        def work():
            updates, n = [], node
            while n and n.kind not in CONTAINERS:
                updates.append((n, self.plex.metadata(n.key)))
                n = n.parent
            return updates

        try:
            updates = self.net("refreshing", work)
        except Cancelled:
            return
        except PlexError as e:
            self.fail(e)
            return
        for n, data in updates:
            n.data = data or n.data
        if node.children is not None:
            self.reload(node)
        for hub in self.root.children or []:
            if hub.kind == "hub" and hub.children is not None:
                self.reload(hub)

    # navigation

    def rows(self):
        out, stack = [], list(reversed(self.root.children or []))
        while stack:
            n = stack.pop()
            out.append(n)
            if n.expanded and n.children:
                stack.extend(reversed(n.children))
        return out

    def index(self, rows):
        if not rows:
            self.sel = None
            return 0
        pos = {id(r): i for i, r in enumerate(rows)}
        n = self.sel
        while n is not None and id(n) not in pos:
            n = n.parent
        self.sel = n if n is not None else rows[0]
        return pos[id(self.sel)]

    def handle(self, key):
        if self.search is not None:
            return self.handle_search(key)
        rows = self.rows()
        i = self.index(rows)
        node = self.sel
        half = max(1, self.body_height // 2)
        moves = {
            "j": i + 1, "down": i + 1, "k": i - 1, "up": i - 1,
            "g": 0, "home": 0, "G": len(rows) - 1, "end": len(rows) - 1,
            "ctrl-d": i + half, "pgdn": i + half, "ctrl-u": i - half, "pgup": i - half,
        }
        if key in ("q", "ctrl-c"):
            self.running = False
        elif key in moves and rows:
            self.sel = rows[max(0, min(len(rows) - 1, moves[key]))]
        elif key == "c":
            self.reconnect()
        elif node is None:
            if key == "r":
                self.load(self.root, force=True)
        elif key in ("l", "right"):
            if node.expanded and node.children:
                self.sel = node.children[0]
            elif not node.leaf and self.load(node):
                node.expanded = True
        elif key in ("h", "left"):
            if node.expanded:
                node.expanded = False
            elif node.parent and node.parent.kind != "root":
                self.sel = node.parent
        elif key == "enter":
            if node.leaf:
                self.play(node, resume=True)
            elif node.expanded:
                node.expanded = False
            elif self.load(node):
                node.expanded = True
        elif key == "p" and node.leaf:
            self.play(node, resume=False)
        elif key == "w" and node.kind not in CONTAINERS:
            self.toggle_watched(node)
        elif key == "r":
            target = node if node.expanded else (node.parent or self.root)
            if self.reload(target):
                self.flash("reloaded", "light_foreground")
        elif key == "/":
            self.search, self.search_origin, self.revealed = "", node, []
        elif key in ("n", "N"):
            self.find(self.last_search, 1 if key == "n" else -1)
            self.revealed = []

    def handle_search(self, key):
        if key in ("esc", "ctrl-c"):
            self.collapse_revealed()
            self.sel, self.search = self.search_origin, None
        elif key == "enter":
            self.last_search, self.search, self.revealed = self.search, None, []
        elif key == "backspace":
            self.search = self.search[:-1]
            self.find(self.search, 0, self.search_origin)
        elif len(key) == 1 and key.isprintable():
            self.search += key
            self.find(self.search, 0, self.search_origin)

    def loaded(self):
        out, stack = [], list(reversed(self.root.children or []))
        while stack:
            n = stack.pop()
            out.append(n)
            stack.extend(reversed(n.children or []))
        return out

    def find(self, query, step, start=None):
        """Search every loaded node (not just visible rows) and reveal the match."""
        nodes = self.loaded()
        if not query or not nodes:
            return
        pos = {id(n): i for i, n in enumerate(nodes)}
        origin = start or self.sel
        i = pos.get(id(origin), 0)
        offsets = range(len(nodes)) if step == 0 else range(1, len(nodes) + 1)
        q = query.lower()
        if self.search is not None:
            self.collapse_revealed()
        for k in offsets:
            node = nodes[(i + (step or 1) * k) % len(nodes)]
            if q in node.label().lower():
                parent = node.parent
                while parent and parent.kind != "root":
                    if not parent.expanded:
                        parent.expanded = True
                        self.revealed.append(parent)
                    parent = parent.parent
                self.sel = node
                return
        self.flash(f"no match for “{query}”", "yellow")

    def collapse_revealed(self):
        for node in self.revealed:
            node.expanded = False
        self.revealed = []

    # actions

    def play(self, node, resume):
        # a display mode change stalls the compositor, and a held enter key then auto-repeats
        if self.player and (self.player.starting or self.player.just_started(node)):
            return
        offset = node.data.get("viewOffset", 0) if resume else 0
        previous = self.player if self.player and self.player.is_alive() else None
        if previous:
            previous.stop()
        self.player = Player(self, node, offset, previous)
        self.player.start()
        verb = f"resuming at {fmt_clock(offset)}" if offset else "playing"
        self.flash(f"{verb}: {node.media_title()}", "accent")

    def toggle_watched(self, node):
        want = not node.watched()
        try:
            self.net("marking " + ("watched" if want else "unwatched"), lambda: self.plex.scrobble(node.key, want))
        except Cancelled:
            return
        except PlexError as e:
            self.fail(e)
            return
        self.refresh_meta(node)
        self.flash("marked watched" if want else "marked unwatched", "green")

    # drawing

    def marker(self, node):
        T = self.theme
        if node.kind in ("section", "hub"):
            icon = node.data.get("hub") or node.data.get("type")
            return SECTION_ICONS.get(icon, "•"), T.fg("accent")
        if node.in_progress():
            return "◐", T.fg("accent")
        if not node.watched():
            return "●", T.fg("accent")
        return " ", ""

    def tree_row(self, node, width, selected):
        T = self.theme
        ln = Line(width, T.bg("selection") if selected else "")
        ln.add("▎" if selected else " ", T.fg("accent"))
        ln.add("  " * node.depth)
        if node.leaf:
            ln.add("  ")
        else:
            ln.add("▾ " if node.expanded else "▸ ", T.fg("light_foreground"))
        mark, style = self.marker(node)
        ln.add(mark + " ", style)
        if selected:
            label_style = T.fg("bright_foreground") + BOLD
        elif node.leaf and node.watched():
            label_style = T.fg("light_foreground")
        else:
            label_style = T.fg("foreground")
        meta = node.meta()
        room = width - ln.used - (wlen(meta) + 3 if meta else 1)
        ln.add(trunc(node.label(), room), label_style)
        if meta:
            ln.right(meta + " ", T.fg("light_foreground"))
        return str(ln)

    def details(self, node, width):
        T = self.theme
        d = node.data
        w = max(10, width - 3)
        lines = [[]]
        accent, bright, fg, dim = T.fg("accent") + BOLD, T.fg("bright_foreground") + BOLD, T.fg("foreground"), T.fg("light_foreground")

        def para(text, style):
            for chunk in textwrap.wrap(str(text), w) or [""]:
                lines.append([(chunk, style)])

        if node.kind == "section":
            para(d.get("title", ""), bright)
            para("movie library" if d.get("type") == "movie" else "tv library", dim)
            if node.children is not None:
                para(plural(len(node.children), "title"), dim)
            return lines

        if node.kind == "hub":
            para(d["title"], bright)
            para(d["summary"], dim)
            if node.children is not None:
                para(plural(len(node.children), "item"), dim)
            return lines

        if node.kind == "episode":
            para(d.get("grandparentTitle", ""), accent)
            para(f"S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} · {d.get('title', '')}", bright)
        elif node.kind == "season":
            para(d.get("parentTitle", ""), accent)
            para(d.get("title", ""), bright)
        else:
            para(d.get("title", ""), bright)

        facts = []
        if node.kind == "episode" and d.get("originallyAvailableAt"):
            facts.append(d["originallyAvailableAt"])
        elif d.get("year"):
            facts.append(str(d["year"]))
        if d.get("contentRating"):
            facts.append(d["contentRating"])
        if node.leaf and d.get("duration"):
            facts.append(fmt_duration(d["duration"]))
        if node.kind == "show" and d.get("childCount"):
            facts.append(plural(d["childCount"], "season"))
        if node.kind in ("show", "season") and d.get("leafCount"):
            facts.append(plural(d["leafCount"], "episode"))
        rating = d.get("audienceRating") or d.get("rating")
        if rating:
            facts.append(f"★ {rating:.1f}")
        if facts:
            para("  ·  ".join(facts), dim)

        lines.append([])
        if node.in_progress() and d.get("duration"):
            bar = max(10, min(w - 16, 32))
            filled = round(bar * d["viewOffset"] / d["duration"])
            lines.append([
                ("━" * filled, T.fg("accent")),
                ("━" * (bar - filled), T.fg("dark_foreground")),
                (f"  {fmt_clock(d['viewOffset'])} / {fmt_clock(d['duration'])}", dim),
            ])
        elif node.leaf:
            lines.append([("✓ watched", T.fg("green"))] if node.watched() else [("● unwatched", T.fg("accent"))])
        elif d.get("leafCount"):
            seen, total = d.get("viewedLeafCount", 0), d["leafCount"]
            style = T.fg("green") if seen >= total else T.fg("accent")
            lines.append([(f"{seen}/{total} watched", style)])

        if d.get("summary"):
            lines.append([])
            para(d["summary"], fg)

        for field, title in (("Genre", "genre"), ("Director", "director"), ("Role", "cast")):
            tags = [t.get("tag") for t in d.get(field) or [] if t.get("tag")]
            if tags:
                lines.append([])
                lines.append([(title, T.fg("dark_foreground"))])
                para(", ".join(tags[:6]), dim)

        media = (d.get("Media") or [{}])[0]
        tech = []
        res = str(media.get("videoResolution") or "")
        if res:
            tech.append(res + "p" if res.isdigit() else res.upper())
        for k in ("videoCodec", "audioCodec"):
            if media.get(k):
                tech.append(media[k])
        if media.get("audioChannels"):
            tech.append(f"{media['audioChannels']}ch")
        if tech:
            lines.append([])
            para(" · ".join(tech), T.fg("dark_foreground"))
        if node.leaf and video_stream(media) is None and not node.detailed:
            node.detailed = True
            threading.Thread(target=self.fetch_details, args=(node,), daemon=True).start()
        hdr, fps = video_info(media) if node.leaf else (None, None)
        if hdr or fps:
            video = []
            if hdr:
                video.append(hdr if self.hdr else f"{hdr} tone-mapped to SDR")
                if hdr == "Dolby Vision" and self.hdr:
                    video[-1] += " as HDR10"
            if fps:
                sync = self.refresh_for(self.display_saved or self.display, fps)
                video.append(f"{fmt_fps(fps)} fps" + (" → VRR" if sync == "vrr" else f" → {sync:g} Hz" if sync else ""))
            lines.append([("video  ", T.fg("dark_foreground")), (" · ".join(video), dim)])
        audio = self.audio
        if node.leaf and audio:
            route = audio.plan(media)[1]
            lines.append([("audio  ", T.fg("dark_foreground")), (f"{route} → {audio.device}", dim)])
        return lines

    def empty_panel(self):
        T = self.theme
        dim, fg, key = T.fg("light_foreground"), T.fg("foreground"), T.fg("accent")
        if self.activity:
            spin = SPINNER[int(time.monotonic() * 10) % len(SPINNER)]
            return [[], [(spin + " ", key), (self.activity[0] + "…", fg)]]
        if not self.error:
            return [[], [("nothing here yet", dim)]]
        addresses = self.cfg.get("connections") or []
        lines = [
            [],
            [("✗ ", T.fg("red") + BOLD), (self.error, T.fg("red"))],
            [],
            [("server   ", dim), (self.server_name, fg)],
            [("address  ", dim), (self.plex.url, fg)],
        ]
        if addresses:
            lines.append([("known    ", dim), (plural(len(addresses), "address"), fg)])
        lines += [
            [],
            [("r", key), (" retry   ", dim), ("c", key), (" reconnect (ask plex.tv for every address)   ", dim), ("q", key), (" quit", dim)],
            [],
            [("log      ", dim), (LOG_PATH.replace(os.path.expanduser("~"), "~"), fg)],
        ]
        return lines

    def current_status(self):
        if self.activity:
            label, started = self.activity
            spin = SPINNER[int(time.monotonic() * 10) % len(SPINNER)]
            return f"{spin} {label} · {time.monotonic() - started:.0f}s · esc cancel", "light_foreground"
        text, color, at, ttl = self.status
        if text and time.monotonic() - at < ttl:
            return text, color
        if self.player and self.player.is_alive():
            return f"▶ {self.player.title}", "accent"
        return "", "foreground"

    def render(self):
        T = self.theme
        w, h = shutil.get_terminal_size()
        out = []
        if self.resized:
            out.append("\x1b[2J")
            self.resized = False
        if w < 40 or h < 8:
            self.write("".join(out) + "\x1b[H" + RESET + trunc("plexi: terminal too small", w))
            return

        rows = self.rows()
        cur = self.index(rows)
        inner, body = w - 2, h - 3
        self.body_height = body
        dw = min(64, inner * 2 // 5) if inner >= 90 else 0
        tw = inner - dw - (1 if dw else 0)

        pad = min(3, body // 4)
        if cur - pad < self.top:
            self.top = cur - pad
        elif cur + pad >= self.top + body:
            self.top = cur + pad - body + 1
        self.top = max(0, min(self.top, len(rows) - body))

        frame, dim = T.fg("dark_foreground"), T.fg("light_foreground")
        lines = []

        top = Line(w).add("╭─", frame).add(" plexi ", T.fg("accent") + BOLD).add(self.server_name + " ", dim)
        if self.audio:
            state = f"passthrough blocked by {', '.join(self.audio.busy)}" if self.audio.busy else "passthrough"
            top.add("─ ", frame).add(f"{self.audio.device} · {state} ", T.fg("dark_foreground"))
        top.add("─" * max(0, w - top.used - 1), frame).add("╮", frame)
        lines.append(str(top))

        detail = self.details(self.sel, dw) if dw and self.sel else []
        panel = [] if rows else self.empty_panel()
        for y in range(body):
            ln = Line(w).add("│", frame)
            r = self.top + y
            if r < len(rows):
                ln.raw(self.tree_row(rows[r], tw, r == cur), tw)
            elif y < len(panel):
                cell = Line(tw).add("  ")
                for text, style in panel[y]:
                    cell.add(text, style)
                ln.raw(str(cell), tw)
            else:
                ln.add(" " * tw)
            if dw:
                ln.add("│", frame)
                cell = Line(dw).add("  ")
                for text, style in detail[y] if y < len(detail) else []:
                    cell.add(text, style)
                ln.raw(str(cell), dw)
            ln.add("│", frame)
            lines.append(str(ln))

        msg, color = self.current_status()
        bottom = Line(w).add("╰─", frame)
        if rows:
            bottom.add(f" {cur + 1}/{len(rows)} ", dim)
        right = trunc(f" {msg} ", max(0, w - bottom.used - 2)) if msg else ""
        bottom.add("─" * max(0, w - bottom.used - wlen(right) - 2), frame)
        bottom.add(right, T.fg(color)).add("─╯", frame)
        lines.append(str(bottom))

        hints = Line(w).add(" ")
        if self.search is not None:
            hints.add("/", T.fg("accent") + BOLD).add(self.search, T.fg("bright_foreground")).add("▏", T.fg("accent"))
            hints.right("enter keep · esc cancel ", dim)
        else:
            for key, label in HINTS:
                hints.add(key, T.fg("accent")).add(f" {label}   ", dim)
        lines.append(str(hints))

        out.extend(f"\x1b[{i + 1};1H{line}" for i, line in enumerate(lines))
        self.write("".join(out))


# ── main ─────────────────────────────────────────────────────────────────


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if cmd in ("-V", "--version"):
        print(f"plexi {VERSION}")
        return 0
    if cmd == "logout":
        cfg = load_config()
        save_config({"client_id": cfg["client_id"]} if cfg.get("client_id") else {})
        print("signed out")
        return 0
    if cmd == "log":
        print(LOG_PATH)
        try:
            with open(LOG_PATH, encoding="utf-8") as f:
                sys.stdout.writelines(f.readlines()[-60:])
        except OSError:
            print("(no log yet)")
        return 0
    if cmd not in ("", "login"):
        print(USAGE, end="", file=sys.stderr)
        return 2

    setup_logging()
    log.info("plexi %s starting (python %s)", VERSION, sys.version.split()[0])
    theme = Theme()
    cfg = load_config()
    url = os.environ.get("PLEX_URL") or cfg.get("server")
    token = os.environ.get("PLEX_TOKEN") or cfg.get("token")

    if cmd == "login" or not (url and token):
        try:
            cfg = login(theme)
        except PlexError as e:
            print(f"  {theme.fg('red')}✗ {e}{RESET}", file=sys.stderr)
            return 1
        except (KeyboardInterrupt, EOFError):
            print()
            return 130
        if cmd == "login":
            return 0
        url, token = cfg["server"], cfg["token"]

    if not sys.stdin.isatty():
        print("plexi needs an interactive terminal", file=sys.stderr)
        return 1

    if not cfg.get("client_id"):
        cfg["client_id"] = str(uuid.uuid4())
        save_config(cfg)

    fixed = bool(os.environ.get("PLEX_URL"))
    log.info("server %s at %s%s", cfg.get("server_name", "?"), url, " (PLEX_URL)" if fixed else "")
    App(Plex(url, token, cfg["client_id"]), cfg, fixed_server=fixed).run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
