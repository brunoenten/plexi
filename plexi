HINTS = [
    ("j/k", "move"), ("l", "open"), ("h", "back"), ("enter", "play"),
    ("p", "from start"), ("w", "watched"), ("/", "find"), ("r", "reload"), ("q", "quit"),
]


class App:
    def __init__(self, plex, server_name):
        self.plex = plex
        self.server_name = server_name
        self.theme = Theme()
        self.root = Node({}, "root", None)
        self.root.expanded = True
        self.sel = None
        self.top = 0
        self.status = ("", "foreground", 0.0, False)
        self.search = None
        self.search_origin = None
        self.last_search = ""
        self.revealed = []
        self.events = queue.Queue()
        self.player = None
        self.running = True
        self.resized = True
        self.body_height = 10
        self.fd = sys.stdin.fileno()

    # lifecycle

    def run(self):
        saved = termios.tcgetattr(self.fd)
        signal.signal(signal.SIGWINCH, lambda *_: setattr(self, "resized", True))
        try:
            tty.setraw(self.fd)
            self.write("\x1b[?1049h\x1b[?25l")
            self.load(self.root)
            while self.running:
                self.theme.reload()
                self.drain_events()
                self.render()
                if select.select([self.fd], [], [], 0.25)[0]:
                    key = read_key(self.fd)
                    if key:
                        self.handle(key)
        finally:
            self.write(RESET + "\x1b[?25h\x1b[?1049l")
            termios.tcsetattr(self.fd, termios.TCSADRAIN, saved)

    def write(self, s):
        sys.stdout.write(s)
        sys.stdout.flush()

    def flash(self, text, color="foreground", sticky=False):
        self.status = (text, color, time.monotonic(), sticky)

    def drain_events(self):
        while True:
            try:
                kind, value = self.events.get_nowait()
            except queue.Empty:
                return
            if kind == "error":
                self.flash(value, "red")
            elif kind == "played":
                self.refresh_meta(value)

    # data

    def fetch(self, node):
        if node.kind == "root":
            return HUBS + self.plex.sections()
        if node.kind == "hub":
            return self.plex.continue_watching() if node.data["hub"] == "continue" else self.plex.recently_added()
        if node.kind == "section":
            return self.plex.items(node.data["key"])
        return self.plex.children(node.key)

    def load(self, node, force=False):
        if node.children is not None and not force:
            return True
        self.flash("loading…", "light_foreground", sticky=True)
        self.render()
        try:
            items = self.fetch(node)
        except PlexError as e:
            self.flash(str(e), "red")
            return False
        existing = {c.key: c for c in node.children or []}
        children = []
        for data in items:
            child = existing.get(data.get("ratingKey") or data.get("key"))
            if child:
                child.data = data
            else:
                if "hub" in data:
                    kind = "hub"
                elif node.kind == "root":
                    kind = "section"
                else:
                    kind = data.get("type")
                child = Node(data, kind, node)
            children.append(child)
        node.children = children
        self.flash("" if children else "nothing here", "light_foreground")
        return True

    def reload(self, node):
        if not self.load(node, force=True):
            return False
        for child in node.children:
            if child.expanded:
                self.reload(child)
        return True

    def refresh_meta(self, node):
        try:
            n = node
            while n and n.kind not in CONTAINERS:
                n.data = self.plex.metadata(n.key) or n.data
                n = n.parent
        except PlexError as e:
            self.flash(str(e), "red")
            return
        if node.children is not None:
            self.reload(node)
        for hub in self.root.children or []:
            if hub.kind == "hub" and hub.children is not None:
                self.reload(hub)

    # navigation

    def rows(self):
        out, stack = [], list(reversed(self.root.children or []))
        while stack:
            n = stack.pop()
            out.append(n)
            if n.expanded and n.children:
                stack.extend(reversed(n.children))
        return out

    def index(self, rows):
        if not rows:
            self.sel = None
            return 0
        pos = {id(r): i for i, r in enumerate(rows)}
        n = self.sel
        while n is not None and id(n) not in pos:
            n = n.parent
        self.sel = n if n is not None else rows[0]
        return pos[id(self.sel)]

    def handle(self, key):
        if self.search is not None:
            return self.handle_search(key)
        rows = self.rows()
        i = self.index(rows)
        node = self.sel
        half = max(1, self.body_height // 2)
        moves = {
            "j": i + 1, "down": i + 1, "k": i - 1, "up": i - 1,
            "g": 0, "home": 0, "G": len(rows) - 1, "end": len(rows) - 1,
            "ctrl-d": i + half, "pgdn": i + half, "ctrl-u": i - half, "pgup": i - half,
        }
        if key in ("q", "ctrl-c"):
            self.running = False
        elif key in moves and rows:
            self.sel = rows[max(0, min(len(rows) - 1, moves[key]))]
        elif node is None:
            if key == "r":
                self.load(self.root, force=True)
        elif key in ("l", "right"):
            if node.expanded and node.children:
                self.sel = node.children[0]
            elif not node.leaf and self.load(node):
                node.expanded = True
        elif key in ("h", "left"):
            if node.expanded:
                node.expanded = False
            elif node.parent and node.parent.kind != "root":
                self.sel = node.parent
        elif key == "enter":
            if node.leaf:
                self.play(node, resume=True)
            elif node.expanded:
                node.expanded = False
            elif self.load(node):
                node.expanded = True
        elif key == "p" and node.leaf:
            self.play(node, resume=False)
        elif key == "w" and node.kind not in CONTAINERS:
            self.toggle_watched(node)
        elif key == "r":
            target = node if node.expanded else (node.parent or self.root)
            if self.reload(target):
                self.flash("reloaded", "light_foreground")
        elif key == "/":
            self.search, self.search_origin, self.revealed = "", node, []
        elif key in ("n", "N"):
            self.find(self.last_search, 1 if key == "n" else -1)
            self.revealed = []

    def handle_search(self, key):
        if key in ("esc", "ctrl-c"):
            self.collapse_revealed()
            self.sel, self.search = self.search_origin, None
        elif key == "enter":
            self.last_search, self.search, self.revealed = self.search, None, []
        elif key == "backspace":
            self.search = self.search[:-1]
            self.find(self.search, 0, self.search_origin)
        elif len(key) == 1 and key.isprintable():
            self.search += key
            self.find(self.search, 0, self.search_origin)

    def loaded(self):
        out, stack = [], list(reversed(self.root.children or []))
        while stack:
            n = stack.pop()
            out.append(n)
            stack.extend(reversed(n.children or []))
        return out

    def find(self, query, step, start=None):
        """Search every loaded node (not just visible rows) and reveal the match."""
        nodes = self.loaded()
        if not query or not nodes:
            return
        pos = {id(n): i for i, n in enumerate(nodes)}
        origin = start or self.sel
        i = pos.get(id(origin), 0)
        offsets = range(len(nodes)) if step == 0 else range(1, len(nodes) + 1)
        q = query.lower()
        if self.search is not None:
            self.collapse_revealed()
        for k in offsets:
            node = nodes[(i + (step or 1) * k) % len(nodes)]
            if q in node.label().lower():
                parent = node.parent
                while parent and parent.kind != "root":
                    if not parent.expanded:
                        parent.expanded = True
                        self.revealed.append(parent)
                    parent = parent.parent
                self.sel = node
                return
        self.flash(f"no match for “{query}”", "yellow")

    def collapse_revealed(self):
        for node in self.revealed:
            node.expanded = False
        self.revealed = []

    # actions

    def play(self, node, resume):
        offset = node.data.get("viewOffset", 0) if resume else 0
        if self.player and self.player.is_alive():
            self.player.stop()
        self.player = Player(self, node, offset)
        self.player.start()
        verb = f"resuming at {fmt_clock(offset)}" if offset else "playing"
        self.flash(f"{verb}: {node.media_title()}", "accent")

    def toggle_watched(self, node):
        want = not node.watched()
        try:
            self.plex.scrobble(node.key, want)
        except PlexError as e:
            self.flash(str(e), "red")
            return
        self.refresh_meta(node)
        self.flash("marked watched" if want else "marked unwatched", "green")

    # drawing

    def marker(self, node):
        T = self.theme
        if node.kind in ("section", "hub"):
            icon = node.data.get("hub") or node.data.get("type")
            return SECTION_ICONS.get(icon, "•"), T.fg("accent")
        if node.in_progress():
            return "◐", T.fg("accent")
        if not node.watched():
            return "●", T.fg("accent")
        return " ", ""

    def tree_row(self, node, width, selected):
        T = self.theme
        ln = Line(width, T.bg("selection") if selected else "")
        ln.add("▎" if selected else " ", T.fg("accent"))
        ln.add("  " * node.depth)
        if node.leaf:
            ln.add("  ")
        else:
            ln.add("▾ " if node.expanded else "▸ ", T.fg("light_foreground"))
        mark, style = self.marker(node)
        ln.add(mark + " ", style)
        if selected:
            label_style = T.fg("bright_foreground") + BOLD
        elif node.leaf and node.watched():
            label_style = T.fg("light_foreground")
        else:
            label_style = T.fg("foreground")
        meta = node.meta()
        room = width - ln.used - (wlen(meta) + 3 if meta else 1)
        ln.add(trunc(node.label(), room), label_style)
        if meta:
            ln.right(meta + " ", T.fg("light_foreground"))
        return str(ln)

    def details(self, node, width):
        T = self.theme
        d = node.data
        w = max(10, width - 3)
        lines = [[]]
        accent, bright, fg, dim = T.fg("accent") + BOLD, T.fg("bright_foreground") + BOLD, T.fg("foreground"), T.fg("light_foreground")

        def para(text, style):
            for chunk in textwrap.wrap(str(text), w) or [""]:
                lines.append([(chunk, style)])

        if node.kind == "section":
            para(d.get("title", ""), bright)
            para("movie library" if d.get("type") == "movie" else "tv library", dim)
            if node.children is not None:
                para(plural(len(node.children), "title"), dim)
            return lines

        if node.kind == "hub":
            para(d["title"], bright)
            para(d["summary"], dim)
            if node.children is not None:
                para(plural(len(node.children), "item"), dim)
            return lines

        if node.kind == "episode":
            para(d.get("grandparentTitle", ""), accent)
            para(f"S{d.get('parentIndex', 0):02d}E{d.get('index', 0):02d} · {d.get('title', '')}", bright)
        elif node.kind == "season":
            para(d.get("parentTitle", ""), accent)
            para(d.get("title", ""), bright)
        else:
            para(d.get("title", ""), bright)

        facts = []
        if node.kind == "episode" and d.get("originallyAvailableAt"):
            facts.append(d["originallyAvailableAt"])
        elif d.get("year"):
            facts.append(str(d["year"]))
        if d.get("contentRating"):
            facts.append(d["contentRating"])
        if node.leaf and d.get("duration"):
            facts.append(fmt_duration(d["duration"]))
        if node.kind == "show" and d.get("childCount"):
            facts.append(plural(d["childCount"], "season"))
        if node.kind in ("show", "season") and d.get("leafCount"):
            facts.append(plural(d["leafCount"], "episode"))
        rating = d.get("audienceRating") or d.get("rating")
        if rating:
            facts.append(f"★ {rating:.1f}")
        if facts:
            para("  ·  ".join(facts), dim)

        lines.append([])
        if node.in_progress() and d.get("duration"):
            bar = max(10, min(w - 16, 32))
            filled = round(bar * d["viewOffset"] / d["duration"])
            lines.append([
                ("━" * filled, T.fg("accent")),
                ("━" * (bar - filled), T.fg("dark_foreground")),
                (f"  {fmt_clock(d['viewOffset'])} / {fmt_clock(d['duration'])}", dim),
            ])
        elif node.leaf:
            lines.append([("✓ watched", T.fg("green"))] if node.watched() else [("● unwatched", T.fg("accent"))])
        elif d.get("leafCount"):
            seen, total = d.get("viewedLeafCount", 0), d["leafCount"]
            style = T.fg("green") if seen >= total else T.fg("accent")
            lines.append([(f"{seen}/{total} watched", style)])

        if d.get("summary"):
            lines.append([])
            para(d["summary"], fg)

        for field, title in (("Genre", "genre"), ("Director", "director"), ("Role", "cast")):
            tags = [t.get("tag") for t in d.get(field) or [] if t.get("tag")]
            if tags:
                lines.append([])
                lines.append([(title, T.fg("dark_foreground"))])
                para(", ".join(tags[:6]), dim)

        media = (d.get("Media") or [{}])[0]
        tech = []
        res = str(media.get("videoResolution") or "")
        if res:
            tech.append(res + "p" if res.isdigit() else res.upper())
        for k in ("videoCodec", "audioCodec"):
            if media.get(k):
                tech.append(media[k])
        if media.get("audioChannels"):
            tech.append(f"{media['audioChannels']}ch")
        if tech:
            lines.append([])
            para(" · ".join(tech), T.fg("dark_foreground"))
        return lines

    def current_status(self):
        text, color, at, sticky = self.status
        if text and (sticky or time.monotonic() - at < 4):
            return text, color
        if self.player and self.player.is_alive():
            return f"▶ {self.player.title}", "accent"
        return "", "foreground"

    def render(self):
        T = self.theme
        w, h = shutil.get_terminal_size()
        out = []
        if self.resized:
            out.append("\x1b[2J")
            self.resized = False
        if w < 40 or h < 8:
            self.write("".join(out) + "\x1b[H" + RESET + trunc("plexi: terminal too small", w))
            return

        rows = self.rows()
        cur = self.index(rows)
        inner, body = w - 2, h - 3
        self.body_height = body
        dw = min(64, inner * 2 // 5) if inner >= 90 else 0
        tw = inner - dw - (1 if dw else 0)

        pad = min(3, body // 4)
        if cur - pad < self.top:
            self.top = cur - pad
        elif cur + pad >= self.top + body:
            self.top = cur + pad - body + 1
        self.top = max(0, min(self.top, len(rows) - body))

        frame, dim = T.fg("dark_foreground"), T.fg("light_foreground")
        lines = []

        top = Line(w).add("╭─", frame).add(" plexi ", T.fg("accent") + BOLD).add(self.server_name + " ", dim)
        top.add("─" * max(0, w - top.used - 1), frame).add("╮", frame)
        lines.append(str(top))

        detail = self.details(self.sel, dw) if dw and self.sel else []
        for y in range(body):
            ln = Line(w).add("│", frame)
            r = self.top + y
            if r < len(rows):
                ln.raw(self.tree_row(rows[r], tw, r == cur), tw)
            else:
                ln.add(" " * tw)
            if dw:
                ln.add("│", frame)
                cell = Line(dw).add("  ")
                for text, style in detail[y] if y < len(detail) else []:
                    cell.add(text, style)
                ln.raw(str(cell), dw)
            ln.add("│", frame)
            lines.append(str(ln))

        msg, color = self.current_status()
        bottom = Line(w).add("╰─", frame)
        if rows:
            bottom.add(f" {cur + 1}/{len(rows)} ", dim)
        right = trunc(f" {msg} ", max(0, w - bottom.used - 2)) if msg else ""
        bottom.add("─" * max(0, w - bottom.used - wlen(right) - 2), frame)
        bottom.add(right, T.fg(color)).add("─╯", frame)
        lines.append(str(bottom))

        hints = Line(w).add(" ")
        if self.search is not None:
            hints.add("/", T.fg("accent") + BOLD).add(self.search, T.fg("bright_foreground")).add("▏", T.fg("accent"))
            hints.right("enter keep · esc cancel ", dim)
        else:
            for key, label in HINTS:
                hints.add(key, T.fg("accent")).add(f" {label}   ", dim)
        lines.append(str(hints))

        out.extend(f"\x1b[{i + 1};1H{line}" for i, line in enumerate(lines))
        self.write("".join(out))


# ── main ─────────────────────────────────────────────────────────────────


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if cmd in ("-V", "--version"):
        print(f"plexi {VERSION}")
        return 0
    if cmd == "logout":
        cfg = load_config()
        save_config({"client_id": cfg["client_id"]} if cfg.get("client_id") else {})
        print("signed out")
        return 0
    if cmd not in ("", "login"):
        print(USAGE, end="", file=sys.stderr)
        return 2

    theme = Theme()
    cfg = load_config()
    url = os.environ.get("PLEX_URL") or cfg.get("server")
    token = os.environ.get("PLEX_TOKEN") or cfg.get("token")

    if cmd == "login" or not (url and token):
        try:
            cfg = login(theme)
        except PlexError as e:
            print(f"  {theme.fg('red')}✗ {e}{RESET}", file=sys.stderr)
            return 1
        except (KeyboardInterrupt, EOFError):
            print()
            return 130
        if cmd == "login":
            return 0
        url, token = cfg["server"], cfg["token"]

    if not sys.stdin.isatty():
        print("plexi needs an interactive terminal", file=sys.stderr)
        return 1

    if not cfg.get("client_id"):
        cfg["client_id"] = str(uuid.uuid4())
        save_config(cfg)

    name = cfg.get("server_name") or urllib.parse.urlsplit(url).hostname or "plex"
    App(Plex(url, token, cfg["client_id"]), name).run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
