def client_headers(client_id, token=None):
    headers = {
        "User-Agent": f"{PRODUCT}/{VERSION}",
        "Accept": "application/json",
        "X-Plex-Product": PRODUCT,
        "X-Plex-Version": VERSION,
        "X-Plex-Client-Identifier": client_id,
